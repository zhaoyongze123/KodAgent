# Chat model is resolved exclusively from the Java agent_model_binding.
# Do not configure an OpenAI or gateway fallback here.
# Optional independent embedding provider. Keep this separate from the chat model credentials.
OA_AGENT_EMBEDDING_API_KEY=
OA_AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Party knowledge production retrieval. Qwen3-VL returns 4096 dimensions;
# PostgreSQL indexes the deterministic 1536-dimension projection.
OA_AGENT_EMBEDDING_PROVIDER=siliconflow
OA_AGENT_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
OA_AGENT_EMBEDDING_DIMENSIONS=4096
OA_AGENT_KNOWLEDGE_EMBEDDING=false
OA_AGENT_PARTY_KNOWLEDGE_JAVA=true
# Never enable this in production: the local index has no current OA ACL.
OA_AGENT_PARTY_KNOWLEDGE_OFFLINE_FALLBACK=false
# SiliconFlow transient retry limit; provider is never switched.
OA_AGENT_MODEL_MAX_RETRIES=5
OA_AGENT_MODEL_TIMEOUT_SECONDS=120
# 聊天模型的地址、密钥和默认绑定只在 Java Agent 模型管理中维护。Python 始终
# 通过 Java 网关访问已绑定模型，不配置本地 relay 或第二套模型出口。
OA_AGENT_CAPABILITY_ROUTING_V2=true
# Java is the authoritative business-action contract.  Strict mode blocks a
# Run before any model call when the Python planner drifts from Java.
OA_AGENT_ACTION_CATALOG_SYNC=true
OA_AGENT_ACTION_CATALOG_STRICT=true
# Old operation-only candidate plans are accepted only when explicitly
# enabled for replaying legacy checkpoints; production keeps this disabled.
OA_AGENT_ACTION_LEGACY_COMPAT=false

# 多轮上下文候选。密钥必须是项目部署环境中的稳定随机值，不能提交真实值；它只
# 用于证明 checkpoint 签发的 candidateId，不能替代 Java 的业务权限校验。
OA_AGENT_CONTEXT_CANDIDATE_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
# 与 script/kodbox/.env 相同的项目级 HMAC 密钥，仅供 Java/KodCloud 桥接使用。
KOD_PROJECT_BRIDGE_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
# true 时只生成候选与审计日志，不会把候选来源字段绑定进写计划，适合灰度观察。
OA_AGENT_CONTEXT_SHADOW_MODE=false
# true 时额外把最近 40 条候选诊断写进 checkpoint；常规生产环境保持 false，
# 通过结构化日志审计，避免无界扩大会话状态。
OA_AGENT_CONTEXT_AUDIT_CHECKPOINT=false

# 推理强度实验。默认关闭；开启后也只有 Java 模型 capabilities 明确声明
# reasoningEffortLevels 包含 medium，且当前处于规划/领域规划阶段时才会提升到
# medium。执行、审批和最终汇总仍不依赖这一实验结果。
OA_AGENT_REASONING_EXPERIMENT=false

# LangGraph Server 本地开发
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=2024

# Java OA 业务 Facade
OA_AGENT_BASE_URL=http://127.0.0.1:48080
OA_AGENT_API_KEY=REPLACE_ME_WITH_A_RANDOM_SERVICE_KEY
OA_AGENT_IDENTITY=
OA_AGENT_IDENTITY_SECRET=REPLACE_ME_WITH_A_RANDOM_IDENTITY_SECRET_32_CHARS_MINIMUM

# 仅本地开发：Java 端也必须设置 OA_AGENT_LEGACY_PRINCIPAL_ENABLED=true
OA_AGENT_DEV_MODE=false
OA_AGENT_CONSOLE_DEV_MODE=false
OA_AGENT_USER_ID=1
OA_AGENT_TENANT_ID=1
OA_AGENT_CHECKPOINTER=postgres
OA_AGENT_CHECKPOINT_PATH=.data/kodagent-checkpoints.sqlite
OA_AGENT_REDIS_URL=redis://127.0.0.1:16379/0
OA_AGENT_AVAILABILITY_TTL_SECONDS=1800

# 可选：本次 Run 选择的模型通过前端 metadata.modelId 传入；未传入时使用下面的默认模型。

# LangGraph Server production persistence (used by `langgraph up`, not `langgraph dev`)
LANGGRAPH_POSTGRES_URI=postgresql://langgraph:langgraph@host.docker.internal:15432/langgraph

# LangSmith 可观测性
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kodagent-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# 项目领域复杂问题使用受控 ReAct 调查；设为 false 可回退到单工具项目查询。
OA_AGENT_PROJECT_REACT=true
