VITE_BASE=/

# 同源部署时，前端通过 nginx 反代访问后端，避免浏览器回环到访问者本机的 127.0.0.1
VITE_BASE_URL=
VITE_GLOB_API_URL=/admin-api

# 文件预览地址由目标服务器在发布时写入 oa-runtime-config.js，不能在构建期配置。

VITE_UPLOAD_TYPE=server
VITE_COMPRESS=none
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=true
VITE_APP_CAPTCHA_ENABLE=true
VITE_INTRANET_DEPLOYMENT=true
