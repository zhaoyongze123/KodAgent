APP_ENV=dev
SPRING_PROFILES_ACTIVE=local
IMPORT_DATABASE=false

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=13306
REDIS_PORT=16379
SERVER_PORT=48080
ADMIN_PORT=18080

JAVA_OPTS="-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom"
MASTER_DATASOURCE_URL="jdbc:mysql://mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true"
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=123456
SLAVE_DATASOURCE_URL="jdbc:mysql://mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true"
SLAVE_DATASOURCE_USERNAME=root
SLAVE_DATASOURCE_PASSWORD=123456
REDIS_HOST=redis

# Explicit local-only Agent credentials. These are not production defaults.
OA_AGENT_API_KEY=kodagent-local-dev-only-20260721
OA_AGENT_IDENTITY_SECRET=kodagent-local-identity-secret-20260721
OA_AGENT_AUTH_ENABLED=true
AGENT_MODEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AGENT_EVENT_POSTGRES_URL=jdbc:postgresql://langgraph-postgres:5432/langgraph
AGENT_EVENT_POSTGRES_USERNAME=langgraph
AGENT_EVENT_POSTGRES_PASSWORD=langgraph
LANGGRAPH_POSTGRES_DB=langgraph
LANGGRAPH_POSTGRES_USER=langgraph
LANGGRAPH_POSTGRES_PASSWORD=langgraph

KOD_SSO_ENABLED=true
KOD_SSO_BASE_URL=http://127.0.0.1:8001/
KOD_SSO_APP_NAME=user:all
KOD_SSO_REDIRECT_URI=http://127.0.0.1:5666/#/auth/kod-sso-login?tenantId=1
KOD_SSO_CALLBACK_BASE_URL=http://127.0.0.1:48080
KOD_SSO_TENANT_ID=1
KOD_SSO_AUTO_CREATE_USER=false

FRONTEND_ENV_FILE=script/docker/env/frontend.dev.env
