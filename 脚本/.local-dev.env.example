# Only one local development port set is supported.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7800

# Local service dependencies. Do not put actual credentials in this file.
# MySQL and Redis remain Docker dependencies for local development.
MASTER_DATASOURCE_URL="jdbc:mysql://127.0.0.1:13306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true"
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}

REDIS_HOST=127.0.0.1
REDIS_APP_PORT=16380
REDIS_DATABASE=0
REDIS_PASSWORD=

# Local KKFileView endpoint. The frontend reads this through the local start script.
OA_FILE_PREVIEW_URL=http://127.0.0.1:18112/onlinePreview
# Docker Desktop hostname used only when KKFileView fetches an OA attachment.
# It does not change the browser or SSO address.
OA_FILE_PREVIEW_FETCH_ORIGIN=http://host.docker.internal:7700

# Local development does not use KodBox SSO by default.
KOD_SSO_ENABLED=false
MYBATIS_PLUS_GLOBAL_CONFIG_DB_CONFIG_ID_TYPE=AUTO
MYBATIS_ENCRYPTOR_PASSWORD=

# Required for WxJava bean initialization. Use inert local values unless
# WeChat login itself is under test.
JUSTAUTH_ENABLED=false
CAPTCHA_ENABLE=false
